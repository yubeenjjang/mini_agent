OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Compose가 생성하는 PostgreSQL·Redis Container 설정입니다.
POSTGRES_USER=agent_user
POSTGRES_PASSWORD=agent_pwd
POSTGRES_DB=agent_db
DATABASE_URL=postgresql://agent_user:agent_pwd@postgresql:5432/agent_db
REDIS_URL=redis://redis:6379/0
PGVECTOR_COLLECTION=travel_documents

# Compose 내부 서비스 간 통신 주소입니다.
BACKEND_API_URL=http://backend:8000
TRAVEL_MCP_URL=http://mcp_server1:8010/mcp
POLICY_MCP_URL=http://mcp_server2:8011/mcp
MCP_HOST=0.0.0.0
MCP_PORT=8010
POLICY_MCP_HOST=0.0.0.0
POLICY_MCP_PORT=8011
